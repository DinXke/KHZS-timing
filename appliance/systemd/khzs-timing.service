[Unit]
Description=KHZS Timing – live timing server
After=network.target khzs-agent.service
Wants=khzs-agent.service

[Service]
User=khzs
Group=khzs
Environment=KHZS_DATA=/var/lib/khzs
Environment=KHZS_AGENT=http://127.0.0.1:8091
Environment=KHZS_ROLE=off
Environment=KHZS_AGENT_KEY_FILE=/var/lib/khzs/agent.key
EnvironmentFile=-/var/lib/khzs/role.env
WorkingDirectory=/var/lib/khzs
ExecStart=/usr/bin/python3 -u /opt/khzs/current/livetiming.py --http-port 80 --bind 0.0.0.0
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/khzs
StandardInput=null
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
