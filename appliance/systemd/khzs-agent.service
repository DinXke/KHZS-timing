[Unit]
Description=KHZS Timing – systeemdienst (netwerk, hotspot, scherm, updates)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
EnvironmentFile=-/var/lib/khzs/debug.env
ExecStart=/usr/bin/python3 -u /opt/khzs/agent/launch.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
